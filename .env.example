# Скопируйте в .env для локального запуска. На сервере .env создаёт deploy/server-setup.sh.
POSTGRES_DB=bank_erp
POSTGRES_USER=bank_erp
POSTGRES_PASSWORD=change-me

# Первый суперадмин создаётся при старте, если пользователей ещё нет
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=change-me-too

# true, когда сервис работает по HTTPS
COOKIE_SECURE=false
